    "category": "sourceMeta.filters[].category",
    "categoryLabel": "sourceMeta.filters[].categoryLabel",
    "group": "sourceMeta.filters[].group",
    "groupLabel": "sourceMeta.filters[].groupLabel",
    "remark": "sourceMeta.filters[].remark"
  },
  "remarkPolicy": {
    "purpose": "Only fill when the direct acquisition object does not reveal its owning content or gameplay context.",
    "examples": [
      "token/coffer/lockbox -> owning duty, raid tier, field zone, or activity",
      "quest/material anchor -> owning relic series or field operation zone"
    ],
    "notFor": [
      "Repeating the acquisition text already shown on the detail page",
      "Guessing content that is not present in Garland, datamining, or a manual mapping table"
    ]
  },
